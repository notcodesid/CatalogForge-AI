# Copy this file to .env.local

# Postgres from docker-compose.yml (note: port 5433)
DATABASE_URL=postgres://catalogforge:catalogforge@localhost:5433/catalogforge

# Separate database for tests, created by docker/postgres-init
TEST_DATABASE_URL=postgres://catalogforge:catalogforge@localhost:5433/catalogforge_test

# Which AI writes the products: "anthropic" (Claude, the main one), "deepseek", or "mock" (offline, free: tests
# and demo mode)
AI_PROVIDER=mock

# Claude: key from https://platform.claude.com (needed when AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL_CHEAP=claude-haiku-5-5
# ANTHROPIC_MODEL_STRONG=claude-sonnet-5-5

# DeepSeek: key from https://platform.deepseek.com (needed when AI_PROVIDER=deepseek)
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL_CHEAP=deepseek-flash
# DEEPSEEK_MODEL_STRONG=deepseek-v4-pro

# Calls are spaced out to stay under this many per minute. Claude's limit depends on the account (the console's
# Limits page); 300 is a safe start on a 1,000-a-minute account
# AI_REQUESTS_PER_MINUTE=60
# How many AI batches one worker writes at the same time, and how many it translates next to those (translating is
# most of the work: two languages per product). 10 and 12 suit Claude: about 150 calls a minute, ~80% of its 400k
# output tokens a minute. Unset, translating uses AI_CONCURRENCY
AI_CONCURRENCY=2
# AI_TRANSLATE_CONCURRENCY=12
# Make the mock AI misbehave on purpose, comma separated: invent, fail:N, ratelimit (or ratelimit:N seconds; over 90 the
# import shows "Paused"), nocredit:N, truncate, badjson, notranslate
# MOCK_AI_MODE=invent

# For a small demo deployment, keep the files in the database instead: FILE_STORAGE=database
# Uploaded sheets and photos go to a local folder (STORAGE_DIR, default "storage"). When the web app and the worker
# run on different machines (Render gives each service its own disk), set an S3-compatible bucket instead. For
# Cloudflare R2: the bucket's name, https://<account id>.r2.cloudflarestorage.com, and an R2 API token's keys
# S3_BUCKET=
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# On a host with no always-on machine (Vercel's free plan): run the worker in bursts inside a web function instead of
# `pnpm worker`. Any random string of 16+ characters; it guards /api/worker
# WORKER_KEY=

# On AWS (infra/aws): the database in parts instead of DATABASE_URL, as ECS passes RDS's credentials from Secrets
# Manager; and the CloudWatch namespace the worker reports its queue backlog to, for auto scaling
# PGHOST= PGPORT=5432 PGDATABASE= PGUSER= PGPASSWORD=
# METRICS_NAMESPACE=CatalogForge
